# 复制为 .env，仅用于本地；线上请通过平台环境变量/Secrets 设置。
PUBLIC_ORIGIN=https://your-project.vercel.app
MCD_GATEWAY_TOKEN=
# 只填官方 token 原文，不带 Bearer 前缀；与网关 token 是两个不同凭据。
MCD_UPSTREAM_TOKEN=
MCD_SERVERLESS=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 独立实例使用独立 namespace；更新部署时保持不变。
MCD_STATE_NAMESPACE=mcd-one-click
# GitHub Pages 前端可选，逗号分隔精确 origin，不带仓库路径。
MCD_CORS_ORIGINS=
# 使用 Workers 反代时 PUBLIC_ORIGIN 填 Worker 域名，此项填 Vercel 后端域名。
# INTERNAL_ORIGIN=https://your-project.vercel.app
