{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcd-one-click-edge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "PUBLIC_ORIGIN": "https://mcd-one-click-edge.your-subdomain.workers.dev",
    "BACKEND_ORIGIN": "https://your-project.vercel.app"
  }
}
